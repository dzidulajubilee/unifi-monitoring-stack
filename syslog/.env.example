# Firewall log over syslog (optional; ./install.sh writes this file). See docs/deployment.md.

# Only syslog messages from this address are kept: the UniFi console's IP as it reaches this server.
# Several: separate them with |. Dots are escaped because this is a regular expression, e.g. 192\.168\.1\.1
SYSLOG_FROM=192\.168\.1\.1

# The controller address exactly as in unpoller/.env (UP_UNIFI_CONTROLLER_0_URL), so the dashboards'
# Controller filter covers these entries too
SYSLOG_SOURCE=https://192.168.1.1
