TZ=America/Chicago # change to your timezone

# Login: Dozzle shows every container's logs, so require a username and password.
# Create the users file (ignored by git) with your own username and password:
#   docker run --rm amir20/dozzle:v11.4.1 generate <username> --password '<password>' > dozzle/data/users.yml
DOZZLE_AUTH_PROVIDER=simple
# sign-ins last 7 days instead of ending when the browser closes
DOZZLE_AUTH_TTL=168h

# don't send anonymous usage statistics to the Dozzle developers
DOZZLE_NO_ANALYTICS=true
