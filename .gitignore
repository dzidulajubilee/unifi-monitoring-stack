# Runtime data written by the containers. The folders stay in the repo
# (via .gitkeep) so the bind mounts exist with the right owner on first start.
grafana/data/*
!grafana/data/.gitkeep
prometheus/data/*
!prometheus/data/.gitkeep
loki/data/*
!loki/data/.gitkeep
reporter/out/*
!reporter/out/.gitkeep
dozzle/data/*
!dozzle/data/.gitkeep

# Real settings and credentials: each service has a committed .env.example;
# copy it to .env and edit that. Never commit a .env.
*/.env
# UID/GID for compose.yaml, written by install.sh
/.env

# Optional Caddy proxy for exposing Prometheus or Loki (README): holds password hashes and its certificates
caddy/

# Backups of config files, e.g. unpoller/.env.bak, can hold credentials
*.bak

# Python bytecode
__pycache__/
.pytest_cache/
.ruff_cache/

# Site-specific Prometheus rules (e.g. firewall zone names); see the .example files
prometheus/config/rules/*.yml
