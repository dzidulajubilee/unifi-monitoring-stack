# Runtime data written by the containers. The folders stay in the repo
# (via .gitkeep) so the bind mounts exist with the right owner on first start.
grafana/data/*
!grafana/data/.gitkeep
prometheus/data/*
!prometheus/data/.gitkeep
loki/data/*
!loki/data/.gitkeep
reporter/out/*
!reporter/out/.gitkeep

# Real settings and credentials: each service has a committed .env.example;
# copy it to .env and edit that. Never commit a .env.
*/.env

# Backups of config files, e.g. unpoller/.env.bak, can hold credentials
*.bak
