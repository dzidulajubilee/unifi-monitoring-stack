# Firewall zone names for the Grafana firewall dashboard.
#
# UnPoller's firewall policies name their zones only by ID, and its zone metric has the name but not the ID,
# so the dashboard can't join them by itself. Prometheus publishes each pair listed in zone-names.yml (git
# ignores it) as unifi_firewall_zone_name{zone_id, zone_name}, and the Firewall policies table then shows
# names instead of IDs.
#
# ./install.sh writes zone-names.yml from your controller, and ./install.sh --zones refreshes it: run that
# after a UniFi upgrade (Network 11 gave every zone a new ID) or when you add a zone. To write it by hand
# instead, copy this file; the IDs are in the Firewall policies table (Source zone / Destination zone).
groups:
  - name: unifi-zone-names
    rules:
      - record: unifi_firewall_zone_name
        expr: vector(1)
        labels: {zone_id: "000000000000000000000001", zone_name: "Internal"}
      - record: unifi_firewall_zone_name
        expr: vector(1)
        labels: {zone_id: "000000000000000000000002", zone_name: "External"}
