    {
      "type": "stat",
      "title": "Unrecognised",
      "description": "Share of traffic DPI couldn't name (categories called Unknown). Encrypted traffic is usually still recognised by its service; a high share here often means VPNs or unusual apps.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "((sum(unpoller_client_dpi_receive_bytes{source=~\"$Controller\", site_name=~\"$Site\", mac!=\"TOTAL\", name=~\"$Device\", category=~\"Unknown.*\"}) + sum(unpoller_client_dpi_transmit_bytes{source=~\"$Controller\", site_name=~\"$Site\", mac!=\"TOTAL\", name=~\"$Device\", category=~\"Unknown.*\"})) or vector(0)) / (sum(unpoller_client_dpi_receive_bytes{source=~\"$Controller\", site_name=~\"$Site\", mac!=\"TOTAL\", name=~\"$Device\"}) + sum(unpoller_client_dpi_transmit_bytes{source=~\"$Controller\", site_name=~\"$Site\", mac!=\"TOTAL\", name=~\"$Device\"}))",
          "legendFormat": "",
          "refId": "A",
