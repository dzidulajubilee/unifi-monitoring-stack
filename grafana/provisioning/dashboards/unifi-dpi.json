    {
      "type": "bargauge",
      "title": "Top applications, last 24 h",
      "description": "The 15 applications with the most traffic in the last 24 hours, downloads and uploads together. SSL/TLS and Unknown are encrypted or unrecognised traffic DPI couldn't attribute to a named app.",
