  "description": "What the network's traffic is used for: applications, categories and devices, from UniFi's traffic identification (DPI). UniFi reports each device's application traffic as a rolling 24-hour figure, so panels show the 24 hours up to the end of the selected time range. Needs DPI on in UniFi and UP_UNIFI_CONTROLLER_0_SAVE_DPI=true for UnPoller.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "liveNow": false,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "unifi-poller"
      ],
      "title": "UniFi dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Traffic identified, last 24 h",
      "description": "All traffic UniFi's traffic identification (DPI) recognised in the 24 hours up to the end of the selected time range, downloads and uploads together. Includes traffic between devices on the network, so it can be a little more than the internet line carried.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(unpoller_client_dpi_receive_bytes{source=~\"$Controller\", site_name=~\"$Site\", mac!=\"TOTAL\", name=~\"$Device\"}) + sum(unpoller_client_dpi_transmit_bytes{source=~\"$Controller\", site_name=~\"$Site\", mac!=\"TOTAL\", name=~\"$Device\"}))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 1,
          "noValue": "\u2013",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
