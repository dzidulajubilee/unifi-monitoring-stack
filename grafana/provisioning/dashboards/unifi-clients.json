        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "max by (mac, name, ip, network, ap_name, sw_name, sw_port, wired) (unpoller_client_uptime_seconds{source=~\"$Controller\", site_name=~\"$Site\", network=~\"$Network\", wired=~\"$Connection\", name=~\"$Client\"})",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "max by (mac) (rate(unpoller_client_transmit_bytes_total{source=~\"$Controller\", site_name=~\"$Site\", network=~\"$Network\", wired=~\"$Connection\", name=~\"$Client\"}[5m]) * 8)",
