          "editorMode": "code",
          "expr": "max by (mac) (unpoller_client_radio_signal_db{source=~\"$Controller\", site_name=~\"$Site\", network=~\"$Network\", name=~\"$Client\"})",
          "legendFormat": "",
          "refId": "D",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "max by (mac) (unpoller_client_satisfaction_ratio{source=~\"$Controller\", site_name=~\"$Site\", network=~\"$Network\", name=~\"$Client\"} >= 0)",
          "legendFormat": "",
          "refId": "E",
          "range": false,
          "instant": true,
          "format": "table"
