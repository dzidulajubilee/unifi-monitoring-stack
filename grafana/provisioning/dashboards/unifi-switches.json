        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "max by (name, port_num, port_name) (unpoller_device_port_port_speed_bps{source=~\"$Controller\", site_name=~\"$Site\", name=~\"$Switch\", port_name=~\"$Port\"})",
